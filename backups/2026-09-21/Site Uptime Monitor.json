    },
    {
      "parameters": {
        "jsCode": "return [\n  { json: { name: 'Nusantara Post', url: 'https://www.nusantarapost.news', redisKey: 'uptime:nusantarapost' } },\n  { json: { name: 'Klik Wartaku', url: 'https://klikwartaku.com', redisKey: 'uptime:klikwartaku' } }\n];"
      },
      "id": "e6bb6462-fa6d-45b0-9324-8985308f6a0a",
      "name": "Site List",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        96
      ]
    },
    {
      "parameters": {
        "url": "={{ $json.url }}",
        "options": {
          "redirect": {
            "redirect": {}
          },
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true,
              "responseFormat": "text"
            }
          },
          "timeout": 15000
        }
      },
      "id": "a63f110f-f151-4f4d-a5a7-a2ab4ba929fc",
      "name": "Check Site",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        448,
        96
      ],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const statusCode = $json.statusCode;\nconst name = $('Site List').item.json.name;\nconst url = $('Site List').item.json.url;\nconst redisKey = $('Site List').item.json.redisKey;\nconst isUp = statusCode >= 200 && statusCode < 400;\nconst status = isUp ? 'up' : 'down';\nconst reason = isUp ? '' : ('HTTP ' + statusCode);\nreturn { json: { name, url, redisKey, status, reason } };"
      },
      "id": "aa655e96-39ab-4b77-b15e-5e45a915bcce",
      "name": "Evaluate HTTP Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
        0
      ]
    },
    {
      "parameters": {},
      "id": "642b83bd-761a-4a96-9d16-25acc9bd3ba5",
      "name": "Combine Results",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3.2,
      "position": [
        896,
        96
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const name = $('Site List').item.json.name;\nconst url = $('Site List').item.json.url;\nconst redisKey = $('Site List').item.json.redisKey;\nconst errorMessage = $json.error ? String($json.error) : 'Connection failed (timeout or DNS error)';\nreturn { json: { name, url, redisKey, status: 'down', reason: errorMessage } };",
        "parameters": {
          "jsCode": "const name = $('Site List').item.json.name;\nconst url = $('Site List').item.json.url;\nconst redisKey = $('Site List').item.json.redisKey;\nconst errorMessage = $json.error?.message ? $json.error.message : 'Connection failed (timeout or DNS error)';\nreturn { json: { name, url, redisKey, status: 'down', reason: errorMessage } };"
        }
      },
      "id": "8c8d8a28-07fe-48a2-bca2-27b7d7ed4ffe",
      "name": "Evaluate Connection Error",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        640,
        224
      ]
    },
    {
      "parameters": {
        "operation": "get",
        "propertyName": "lastStatus",
        "key": "={{ $json.redisKey }}",
        "keyType": "string",
        "options": {}
      },
      "id": "d7d3f11a-be08-460d-bfa4-55cbdd2051ec",
      "name": "Get Last Status",
      "type": "n8n-nodes-base.redis",
      "typeVersion": 1,
      "position": [
        1120,
        112
      ],
      "credentials": {
        "redis": {
          "id": "5NS1D9tzoWKw4XNC",
          "name": "Redis account"
        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const name = $('Combine Results').item.json.name;\nconst url = $('Combine Results').item.json.url;\nconst redisKey = $('Combine Results').item.json.redisKey;\nconst status = $('Combine Results').item.json.status;\nconst reason = $('Combine Results').item.json.reason;\nconst lastStatus = $json.lastStatus;\n\nconst isFirstCheck = lastStatus === undefined || lastStatus === null || lastStatus === '';\nconst changed = !isFirstCheck && lastStatus !== status;\n\nlet shouldAlert = false;\nlet message = '';\n\nif (changed) {\n  shouldAlert = true;\n  const timeLabel = $now.toFormat('dd MMM yyyy HH:mm') + ' WIB';\n  if (status === 'down') {\n    message = '*DOWN* ' + name + '\\n' + url + '\\nReason: ' + reason + '\\nTime: ' + timeLabel;\n  } else {\n    message = '*RECOVERED* ' + name + '\\n' + url + '\\nBack up at: ' + timeLabel;\n  }\n}\n\nreturn { json: { name, url, redisKey, status, reason, shouldAlert, message } };"
      },
      "id": "c667c9cb-ab32-462d-a4b7-9281780a1260",
      "name": "Determine Alert",
