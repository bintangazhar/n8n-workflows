{
  "id": "viaV9W7NE0hKIGQR",
  "name": "Site Uptime Monitor",
  "description": "Checks nusantarapost.news and klikwartaku.com every 5 minutes for downtime, connection errors, or HTTP 404, and alerts via Telegram on state change.",
  "active": true,
  "activeVersionId": "5a3f5619-e2c9-439f-9c22-828049d31639",
