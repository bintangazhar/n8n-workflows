      "id": "00523960-9400-4ea3-b0d4-fe819ba7746d",
      "name": "Simpan Log Order",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [
        544,
        304
      ]
    },
    {
      "parameters": {
        "jsCode": "const raw = $('Form Order Sortir Foto').first().json.kodeFoto || '';\nconst lines = raw.split(/[\\n,]+/).map(s => s.trim()).filter(s => s.length > 0);\nconst results = lines.map(line => {\n  const match = line.match(/(\\d+)$/);\n  return { raw: line, code: match ? match[1] : null };\n});\nreturn results.map(r => ({ json: r }));"
      },
      "id": "22b039c2-8905-4c66-9680-86c181d9f31e",
      "name": "Parse & Normalisasi Kode",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        848,
        304
      ]
    },
    {
      "parameters": {
        "resource": "fileFolder",
        "returnAll": true,
        "filter": {
          "folderId": {
            "__rl": true,
            "mode": "id",
            "value": "ISI_FOLDER_ID_SOURCE_DI_SINI"
          },
          "whatToSearch": "files"
        },
        "options": {}
      },
      "id": "70aa8c1a-64dc-4ffc-ac93-8fac5348c5f8",
      "name": "Cari File di Folder Source",
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [
        1152,
        304
      ],
      "executeOnce": true,
      "credentials": {
        "googleDriveOAuth2Api": {
          "id": "fqaj1KELJO7yspxN",
          "name": "Google Drive account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const requested = $('Parse & Normalisasi Kode').all().map(i => i.json);\nconst files = $input.all().map(i => i.json);\n\nconst results = requested.map(r => {\n  if (!r.code) {\n    return { raw: r.raw, status: 'invalid' };\n  }\n  const matches = files.filter(f => {\n    const name = (f.name || '').replace(/\\.[^/.]+$/, '');\n    return name.endsWith(r.code);\n  });\n  if (matches.length === 1) {\n    return { raw: r.raw, code: r.code, status: 'found', fileId: matches[0].id, fileName: matches[0].name };\n  }\n  if (matches.length > 1) {\n    return { raw: r.raw, code: r.code, status: 'ambiguous', matchCount: matches.length, candidates: matches.map(m => m.name).join(', ') };\n  }\n  return { raw: r.raw, code: r.code, status: 'not_found' };\n});\n\nreturn results.map(r => ({ json: r }));"
      },
      "id": "d0db42f8-1cda-4d9f-bbcd-86b87eac7d91",
      "name": "Cocokkan Kode dengan File",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1440,
        304
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 3
          },
          "conditions": [
            {
              "leftValue": "={{ $json.status }}",
              "rightValue": "found",
              "operator": {
                "type": "string",
                "operation": "equals"
              },
              "id": "92609bff-a4ec-44be-914f-7ad22cde7a97"
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "7051c1d0-7d60-4b4b-9c94-2b4e0f9f66fe",
      "name": "Hanya yang Ditemukan",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 2.3,
      "position": [
        1744,
        304
      ]
    },
    {
      "parameters": {
        "jsCode": "const all = $('Cocokkan Kode dengan File').all().map(i => i.json);\nconst found = all.filter(r => r.status === 'found');\nconst ambiguous = all.filter(r => r.status === 'ambiguous');\nconst notFound = all.filter(r => r.status === 'not_found' || r.status === 'invalid');\n\nlet html = '<p>Total diminta: ' + all.length + '</p>';\nhtml += '<p>Berhasil disortir & dicopy: ' + found.length + '</p>';\nif (ambiguous.length) {\n  html += '<p><b>Perlu dicek manual (kode ambigu):</b><br>' + ambiguous.map(a => a.raw + ' - ' + a.matchCount + ' kandidat (' + a.candidates + ')').join('<br>') + '</p>';\n}\nif (notFound.length) {\n  html += '<p><b>Tidak ditemukan:</b><br>' + notFound.map(n => n.raw).join('<br>') + '</p>';\n}\n\nreturn [{ json: { summaryHtml: html } }];"
      },
      "id": "bdc15159-6875-400f-b9a4-336b530183e2",
      "name": "Susun Ringkasan Hasil",
