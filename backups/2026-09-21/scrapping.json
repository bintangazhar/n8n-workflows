    {
      "parameters": {
        "jsCode": "const volumes = $('Volume Akhir').all().map((i) => i.json);\nconst mentions = $('Mention Akhir').all().map((i) => i.json);\n\nconst keyword = volumes.find((v) => v.keyword)?.keyword || mentions.find((m) => m.keyword)?.keyword || '';\n\nconst volumeData = volumes.map((v) => ({\n  platform: v.platform,\n  volume: v.volume,\n  links: Array.isArray(v.links) ? v.links.slice(0, 10) : [],\n  scrapedAt: v.scrapedAt,\n}));\n\nconst mentionData = mentions.map((m) => ({\n  keyword: m.keyword,\n  platform: m.platform,\n  source: m.source,\n  title: m.title,\n  link: m.link,\n  publishedAt: m.publishedAt,\n  sentiment: m.sentiment,\n  associations: typeof m.associations === 'string' ? JSON.parse(m.associations || '[]') : (m.associations || []),\n}));\n\nreturn [{\n  json: {\n    keyword,\n    scrapedAt: new Date().toISOString(),\n    volume: volumeData,\n    sentiment: {\n      total: mentions.length,\n      positive: mentions.filter((m) => m.sentiment === 'positive').length,\n      neutral: mentions.filter((m) => m.sentiment === 'neutral').length,\n      negative: mentions.filter((m) => m.sentiment === 'negative').length,\n    },\n    mentions: mentionData,\n  },\n}];"
      },
