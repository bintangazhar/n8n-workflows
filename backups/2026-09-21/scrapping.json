    {
      "parameters": {
        "jsCode": "const groups = {};\nfor (const item of items) {\n  const platform = item.json.platform || 'Lainnya';\n  if (!groups[platform]) groups[platform] = [];\n  groups[platform].push(item.json.link || '');\n}\nconst keyword = items[0]?.json?.keyword || '';\nconst result = [];\nfor (const [platform, links] of Object.entries(groups)) {\n  result.push({ json: { keyword, platform, volume: links.length, links } });\n}\nreturn result;"
      },
