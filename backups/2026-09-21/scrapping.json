    {
      "parameters": {
        "jsCode": "const POSITIVE = ['bantuan', 'dukungan', 'apresiasi', 'berhasil', 'sinergi', 'pujian', 'sukses', 'penghargaan', 'terima kasih', 'kesejahteraan', 'wujud', 'optimal', 'membantu', 'didukung', 'mempercepat', 'progres'];\nconst NEGATIVE = ['kritik', 'gugatan', 'protes', 'kerugian', 'penyimpangan', 'konflik', 'keluhan', 'korban', 'kebakaran', 'karhutla', 'terancam', 'gagal', 'masalah', 'kontroversi', 'tuntut', 'mencekam', 'buruk', 'ancaman', 'dampak'];\nconst TOPICS = {\n  karhutla: ['karhutla', 'kebakaran hutan', 'kabut asap', 'titik api'],\n  bencana: ['bencana', 'banjir', 'logistik', 'pengungsi'],\n  anggaran: ['anggaran', 'rupiah', 'miliar', 'triliun', 'dana'],\n  politik: ['politik', 'partai', 'golkar', 'pilgub', 'pemilihan', 'pencalonan', 'koalisi'],\n  hukum: ['hukum', 'gugatan', 'penyimpangan', 'audit', 'pengadilan', 'korupsi'],\n  ekonomi: ['ekonomi', 'dagang', 'ekspor', 'investasi', 'perdagangan', 'usaha'],\n  infrastruktur: ['infrastruktur', 'jalan', 'jembatan', 'pelabuhan', 'bandara', 'terminal', 'kijing'],\n  pendidikan: ['pendidikan', 'sekolah', 'universitas', 'iain', 'uin', 'kampus'],\n  lingkungan: ['lingkungan', 'hutan', 'asap', 'polusi', 'udara'],\n  pemerintahan: ['pemprov', 'gubernur', 'sekda', 'asn', 'birokrasi', 'pemerintah daerah']\n};\n\nconst countMatches = (text, words) => words.filter((w) => text.includes(w)).length;\n\nfor (const item of items) {\n  const text = `${item.json.title || ''} ${item.json.content || ''}`.toLowerCase();\n  const pos = countMatches(text, POSITIVE);\n  const neg = countMatches(text, NEGATIVE);\n  let sentiment = 'neutral';\n  if (neg > pos) sentiment = 'negative';\n  else if (pos > neg) sentiment = 'positive';\n  const associations = [];\n  for (const [topic, keywords] of Object.entries(TOPICS)) {\n    if (countMatches(text, keywords) > 0) associations.push(topic);\n    if (associations.length >= 5) break;\n  }\n  item.json.sentiment = sentiment;\n  item.json.associations = associations;\n  item.json.content = item.json.content || '';\n}\nreturn items;"
      },
