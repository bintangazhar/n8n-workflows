      ]
    },
    {
      "parameters": {
        "chatId": "6257097742",
        "text": "=\"🌧️ *Peringatan Hujan - \" + $json.location + \"*\\n\\nPotensi hujan tinggi dalam 3 jam ke depan!\\nProbabilitas tertinggi: *\" + $json.maxProbability + \"%*\\n\\n\" + $json.rainHours.map(h => \"• \" + h.time + \" WIB - \" + h.probability + \"%\").join(\"\\n\") + \"\\n\\n_Bawa payung ya!_ ☔\"",
        "additionalFields": {
