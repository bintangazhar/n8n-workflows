    {
      "parameters": {
        "url": "https://api.open-meteo.com/v1/forecast",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "latitude",
              "value": "-0.0353948"
            },
            {
              "name": "longitude",
              "value": "109.2491484"
            },
            {
              "name": "hourly",
              "value": "precipitation_probability,precipitation"
            },
            {
              "name": "timezone",
              "value": "Asia/Jakarta"
            },
            {
              "name": "forecast_days",
              "value": "1"
            }
          ]
        },
        "options": {}
      },
      "id": "cec98d7c-b546-40f4-9eb2-48696d3eb7cd",
      "name": "Get Weather Forecast",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        448,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const data = $input.first().json;\nconst now = new Date();\nconst threeHoursLater = new Date(now.getTime() + 3 * 60 * 60 * 1000);\n\nconst hourly = data.hourly;\nconst times = hourly.time.map(t => new Date(t));\n\nlet maxRainProb = 0;\nlet rainHours = [];\n\nfor (let i = 0; i < times.length; i++) {\n  if (times[i] >= now && times[i] <= threeHoursLater) {\n    const prob = hourly.precipitation_probability[i] || 0;\n    if (prob > maxRainProb) maxRainProb = prob;\n    if (prob >= 60) {\n      rainHours.push({\n        time: times[i].toLocaleTimeString('id-ID', { hour: '2-digit', minute: '2-digit' }),\n        probability: prob\n      });\n    }\n  }\n}\n\nreturn [{\n  json: {\n    hasHighRainRisk: maxRainProb >= 60,\n    maxProbability: maxRainProb,\n    rainHours: rainHours,\n    location: \"Pontianak\"\n  }\n}];"
      },
      "id": "243a1271-b84d-433e-a213-c84ce5956c98",
      "name": "Check Rain Probability",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
        0
      ]
    },
    {
