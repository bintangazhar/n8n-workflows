    {
      "parameters": {
        "jsCode": "const data = $input.first().json;\nconst qty = Number(data.qty);\nconst hargaSatuan = Number(data.hargaSatuan);\nconst total = qty * hargaSatuan;\nconst dateStr = $now.toFormat('yyyyMMdd-HHmmss');\nconst nomorInvoice = `INV-${$now.toFormat('yyyyMM')}-${$now.toFormat('HHmmss')}`;\nconst tanggalInvoice = $now.toFormat('dd MMMM yyyy');\nconst jatuhTempo = data.jatuhTempo;\nconst fileName = `Invoice-${nomorInvoice}-${data.namaKlien}`.replace(/[^a-zA-Z0-9-_ ]/g, '').replace(/\\s+/g, '-');\nreturn [{\n  json: {\n    status: 'pending',\n    namaKlien: data.namaKlien,\n    emailKlien: data.emailKlien,\n    namaProyek: data.namaProyek,\n    item: data.item,\n    qty: String(qty),\n    hargaSatuan: hargaSatuan.toLocaleString('id-ID'),\n    total: total.toLocaleString('id-ID'),\n    tanggalInvoice,\n    jatuhTempo,\n    nomorInvoice,\n    fileName\n  }\n}];\n"
      },
