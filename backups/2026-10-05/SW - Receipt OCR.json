          "value": "models/gemini-2.5-flash",
          "mode": "list",
          "cachedResultName": "models/gemini-2.5-flash"
        },
        "text": "=Analyze this shopping receipt. Reply in EXACTLY this format (no other text):\n\nTOKO: [store name]\nTOTAL: [amount only, no Rp/dots]\nITEMS: [items purchased, copy EXACTLY as written including punctuation in names, comma-separated]\nTANGGAL: [YYYY-MM-DD format, convert from any format on the receipt. If no date visible → {{ $now.format('yyyy-MM-dd') }}]\n\nExample:\nTOKO: Alfamart\nTOTAL: 25500\nITEMS: Susu Ultra 1L, Roti Tawar, Sabun Lifebuoy, Pembayaran QRIS\nTANGGAL: 2025-06-19\n\nIf unreadable, reply only:\nERROR: Struk tidak dapat dibaca dengan jelas",
        "inputType": "binary",
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.googleGemini",
      "typeVersion": 1,
      "position": [
        -1440,
        240
      ],
      "id": "938cd95a-b36a-4aaf-9e4a-b1be58e9b44b",
      "name": "Analyze Receipt Image",
      "credentials": {
        "googlePalmApi": {
          "id": "QVYkHlJCbUcVHNDj",
          "name": "Google Gemini(PaLM) Api account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Back to regex parsing of the TOKO:/TOTAL:/ITEMS:/TANGGAL: text format\n// (proven more accurate at reading item names than asking Gemini to reply with JSON directly).\nconst raw = $input.first().json.content.parts[0].text;\n\nif (raw.includes('ERROR:')) {\n  return [{ json: { ok: false, reason: raw.replace(/ERROR:\\s*/, '').trim() } }];\n}\n\nconst tokoMatch = raw.match(/TOKO:\\s*(.+)/);\nconst totalMatch = raw.match(/TOTAL:\\s*(.+)/);\nconst itemsMatch = raw.match(/ITEMS:\\s*(.+)/);\nconst tanggalMatch = raw.match(/TANGGAL:\\s*(.+)/);\n\nconst toko = tokoMatch ? tokoMatch[1].trim() : '';\n// Total cleaned of any leftover 'Rp' or thousands separators the model might slip in\nconst total = totalMatch ? totalMatch[1].replace(/[^0-9]/g, '').trim() : '';\nconst items = itemsMatch ? itemsMatch[1].trim() : '';\nlet tanggal = tanggalMatch ? tanggalMatch[1].trim() : '';\n\n// Safety net: required fields (toko & total) empty means parsing failed entirely,\n// even if the model didn't explicitly say ERROR.\nif (!toko || !total) {\n  return [{ json: { ok: false, reason: 'Failed to parse the AI response format (toko/total empty).' } }];\n}\n\n// Second safety net: date is still required, even though the prompt already asks the AI to fill it in itself.\nif (!tanggal) {\n  tanggal = $now.format('yyyy-MM-dd');\n}\nif (!items) items = '-';\n\nreturn [{ json: { ok: true, toko, total, items, tanggal } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -1216,
        240
      ],
      "id": "043cbfc1-6aa5-45b0-80fc-e1396da72c41",
      "name": "Parse Receipt Text"
    },
    {
